{% extends '@ibexadesign/ui/form_fields.html.twig' %}

{%- block checkbox_widget -%}
    {{ block('form_label') }}
    {{ block('toggle_widget') }}
{%- endblock -%}

{% block datetime_widget -%}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' ibexa_dataflow-date')|trim}) %}
    {{ parent() }}
{%- endblock datetime_widget %}
