{% set id = identifier|default('ibexa_dataflow_history_results') %}

{% import '@ibexadesign/ibexa_dataflow/macros.twig' as macros %}

<div id="loading_{{ id }}" class="text-center" hidden>
    <svg class="ez-icon ez-icon--extra-large">
        <use xmlns:xlink="http://www.w3.org/1999/xlink"
             xlink:href="{{ ibexa_icon_path('spinner') }}"></use>
    </svg>
</div>

<div id="{{ id }}" data-loader="loading_{{ id }}" class="history-details-aware">

    {% set body_rows = [] %}

    {% for job in pager.currentPageResults %}
        {% set body_row_cols = [] %}
        {% set body_row_cols = body_row_cols|merge([
            {content: job.label},
            {content: date(job.requested_date)|ibexa_short_datetime},
            {content: job.count is not null ? job.count|format_number(locale: app.request.locale) : '—'},
            {content: job.exception_count|format_number(locale: app.request.locale)},
            {content: job.start_time ? date(job.start_time)|ibexa_short_datetime : '—'},
            {content: job.end_time ? date(job.end_time)|ibexa_short_datetime : '—'},
            {content: macros.translateStatus(job.status)},
        ]) %}

        {% set col_raw %}
            <a href="{{ path('coderhapsodie.ibexa_dataflow.job.details', {id: job.id}) }}"
               class="btn ibexa-btn ibexa-btn--ghost ibexa-btn--no-text modal-history-details"
               title="{{ 'coderhapsodie.ibexa_dataflow.history.list.view'|trans }}"
               data-bs-toggle="modal"
               data-bs-target="#modal-history-details"
            >
                <svg class="ibexa-icon ibexa-icon--small ibexa-icon--about-info">
                    <use xlink:href="{{ ibexa_icon_path('about-info') }}"></use>
                </svg>
            </a>
            <a href="{{ path('coderhapsodie.ibexa_dataflow.job.log', {id: job.id}) }}"
               class="btn ibexa-btn ibexa-btn--ghost ibexa-btn--no-text modal-history-log"
               data-bs-toggle="modal"
               data-bs-target="#modal-history-log"
               title="{{ 'coderhapsodie.ibexa_dataflow.history.details.log'|trans }}"
            >
                <svg class="ibexa-icon ibexa-icon--small ibexa-icon--article">
                    <use xlink:href="{{ ibexa_icon_path('article') }}"></use>
                </svg>
            </a>
            {% if job.scheduled_dataflow_id is null and job.status == 0 %}
                <form action="{{ path('coderhapsodie.ibexa_dataflow.job.delete', {id: job.id}) }}" method="POST">
                    <button type="submit" class="btn ibexa-btn ibexa-btn--ghost ibexa-btn--no-text"
                            title="{{ 'coderhapsodie.ibexa_dataflow.job.delete'|trans }}"
                    >
                        <svg class="ibexa-icon ibexa-icon--small ibexa-icon--trash" style="fill: red">
                            <use xlink:href="{{ ibexa_icon_path('trash') }}"></use>
                        </svg>
                    </button>
                </form>
            {% endif %}
        {% endset %}
        {% set body_row_cols = body_row_cols|merge([{
            has_action_btns: true,
            content: col_raw,
            raw: true,
        }]) %}

        {% set body_rows = body_rows|merge([{ cols: body_row_cols }]) %}
    {% endfor %}

    {% embed '@ibexadesign/ui/component/table/table.html.twig' with {
        headline: headline ?? null,
        head_cols: [
            { content: 'coderhapsodie.ibexa_dataflow.history.list.name'|trans },
            { content: 'coderhapsodie.ibexa_dataflow.history.list.request'|trans },
            { content: 'coderhapsodie.ibexa_dataflow.history.list.count'|trans },
            { content: 'coderhapsodie.ibexa_dataflow.history.list.errors'|trans },
            { content: 'coderhapsodie.ibexa_dataflow.history.list.start'|trans },
            { content: 'coderhapsodie.ibexa_dataflow.history.list.end'|trans },
            { content: 'coderhapsodie.ibexa_dataflow.history.list.status'|trans },
            { },
        ],
        body_rows,
        empty_table_info_text: 'coderhapsodie.ibexa_dataflow.history.list.empty'|trans,
    } %}
        {% block header %}
            {% embed '@ibexadesign/ui/component/table/table_header.html.twig' %}
                {% block actions %}
                    {{ actions ?? '' }}
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}

    <div class="pag">
        {% if pager.haveToPaginate %}
            {% include '@ibexadesign/ui/pagination.html.twig' with {
                'pager': pager,
                'paginaton_params': {
                    'routeName': paginate_route,
                    'routeParams': paginate_params|default({})
                }
            } %}
        {% endif %}
    </div>
</div>
